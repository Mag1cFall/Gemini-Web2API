# 单个认证文件、认证目录或逗号分隔的多个路径
GEMINI_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:8007

# 是否写入 Gemini 官网历史记录
GEMINI_SAVE_HISTORY=false

# 本地 API 认证密钥，多个 key 用逗号分隔
PROXY_API_KEY=

# 代理池，多个代理用逗号分隔，支持 HTTP、HTTPS、SOCKS4、SOCKS5；没有固定代理的账号各绑定其中一个，为空时使用系统代理
PROXY=

# 外部模型名到动态目录模型 ID 的映射，格式为 别名:模型 ID，多项用逗号分隔，例如 gpt-4o:gemini-3.8-flash
MODEL_MAPPING=

# 上游失败后的账号冷却时长
ACCOUNT_COOLDOWN=2m

# 显式会话存活时长
SESSION_TTL=30m

# 单账号启动初始化超时
INIT_TIMEOUT=20s

# 每个账号同时进行的上游请求数
PER_ACCOUNT_CONCURRENCY=1

# 无会话请求的调度策略：round-robin 在账号间轮流分配，fill-first 优先使用排在前面的空闲账号
ROUTING_STRATEGY=round-robin

# 日志级别：debug、info、warn、error
LOG_LEVEL=info

# 控制台日志格式：text 为彩色分列文本，json 为逐行 JSON
LOG_FORMAT=text

# 是否在请求账本中保存最近 1000 条请求与响应正文
REQUEST_BODY_LOG=false

# 同时把服务日志写入 data/logs/gemini-web2api.log，单文件 10 MB 轮转，保存后立即生效
LOG_FILE=true

# 日志目录总量上限（MB），超出时删除最旧的文件，不小于 20
LOG_MAX_TOTAL_MB=500

# 管理端登录；关闭时管理端只接受本机访问
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
