# 单个认证文件、认证目录或逗号分隔的多个路径
GEMINI_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:8007

# 是否写入 Gemini 官网历史记录
GEMINI_SAVE_HISTORY=false

# 本地 API 认证密钥
PROXY_API_KEY=

# 所有账号使用的默认 HTTP、HTTPS 或 SOCKS5 代理
PROXY=

# 外部模型名到动态目录模型 ID 的映射
MODEL_MAPPING=

# 上游失败后的账号冷却时长
ACCOUNT_COOLDOWN=2m

# 显式会话存活时长
SESSION_TTL=30m

# 单账号启动初始化超时
INIT_TIMEOUT=20s
